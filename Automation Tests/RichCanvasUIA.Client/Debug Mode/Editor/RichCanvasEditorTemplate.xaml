                        </Line>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type models:DrawingEndedRepresentation}">
                        <TextBlock Text="DRAWING ENDED" />
                    </DataTemplate>-->
                </rc:RichCanvas.Resources>
