<UserControl x:Class="RichCanvasUIA.Client.Debug_Mode.Overlay.Menus.ZoomingSettingsMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:RichCanvasUIA.Client.Debug_Mode.Overlay.Menus"
             xmlns:editor="clr-namespace:RichCanvasUIA.Client.Debug_Mode.Editor"
             xmlns:converters="clr-namespace:RichCanvasUIA.Client.Converters"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800"
             d:DataContext="{d:DesignInstance editor:RichCanvasSettings}">
    <UserControl.Resources>
        <converters:StringToDoubleConverter x:Key="StringToDoubleConverterKey" />
    </UserControl.Resources>
    <Grid>
        <Menu>
            <MenuItem Header="Zooming">
                <TextBlock ToolTip="Zooming factor. Used for increasing/decreasing each zoom step."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                    <TextBlock.Inlines>
                        <Run Text="Zoom factor: "
                             BaselineAlignment="Center" />
                        <TextBox Text="{Binding ZoomFactor, Converter={StaticResource StringToDoubleConverterKey}}" />
                    </TextBlock.Inlines>
                </TextBlock>
            </MenuItem>
        </Menu>
    </Grid>
</UserControl>
