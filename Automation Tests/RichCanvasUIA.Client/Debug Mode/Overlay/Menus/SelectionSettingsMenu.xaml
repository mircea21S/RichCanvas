<UserControl x:Class="RichCanvasUIA.Client.Debug_Mode.Overlay.Menus.SelectionSettingsMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:RichCanvasUIA.Client.Debug_Mode.Overlay.Menus"
             xmlns:editor="clr-namespace:RichCanvasUIA.Client.Debug_Mode.Editor"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800"
             d:DataContext="{d:DesignInstance editor:RichCanvasSettings}">
    <Grid>
        <Menu>
            <MenuItem Header="Selection">
                <CheckBox IsChecked="{Binding RealTimeSelectionEnabled}"
                          Content="Real-time selection"></CheckBox>
                <CheckBox IsChecked="{Binding CanSelectMultipleItems}"
                          Content="Can select multiple items"></CheckBox>
            </MenuItem>
        </Menu>
    </Grid>
</UserControl>
