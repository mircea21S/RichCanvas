<UserControl x:Class="RichCanvasUIA.Client.Debug_Mode.Overlay.RichCanvasToolbox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:RichCanvasUIA.Client.Debug_Mode.Overlay"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <DockPanel>
        <Rectangle Fill="Red"
                   Width="100"
                   Height="10"
                   DockPanel.Dock="Top" />
        <Rectangle Fill="Red"
                   Width="100"
                   Height="10"
                   DockPanel.Dock="Bottom" />
        <Rectangle Fill="Red"
                   Width="50"
                   Height="100"
                   DockPanel.Dock="Right" />
        <Rectangle Fill="Red"
                   Width="100"
                   Height="10" />
    </DockPanel>
</UserControl>
