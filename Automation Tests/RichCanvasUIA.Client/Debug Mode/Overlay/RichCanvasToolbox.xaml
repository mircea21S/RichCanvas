<UserControl x:Class="RichCanvasUIA.Client.Debug_Mode.Overlay.RichCanvasToolbox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:RichCanvasUIA.Client.Debug_Mode.Overlay"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800"
             d:DataContext="{d:DesignInstance local:RichCanvasToolboxViewModel}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="auto" />
        </Grid.ColumnDefinitions>

        <!--settings panel-->
        <local:RichCanvasSettingsPanel DataContext="{Binding RichCanvasEditor.Settings}" />

        <!--actions toolbar-->
        <DockPanel Grid.Column="1"
                   VerticalAlignment="Bottom">
            <ToolBarTray HorizontalAlignment="Center">
                <ToolBar Band="1">
                    <Button Content="HO">
                    </Button>
                    <Button Content="HO">
                    </Button>
                    <Button Content="HO">
                    </Button>
                </ToolBar>
            </ToolBarTray>
        </DockPanel>

        <!--RichCanvas items preview-->
    </Grid>
</UserControl>
