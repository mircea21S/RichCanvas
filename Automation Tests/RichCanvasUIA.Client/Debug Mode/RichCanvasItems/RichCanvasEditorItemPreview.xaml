<UserControl x:Class="RichCanvasUIA.Client.Debug_Mode.RichCanvasItems.RichCanvasEditorItemPreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:RichCanvasUIA.Client.Debug_Mode.RichCanvasItems"
             xmlns:editor="clr-namespace:RichCanvasUIA.Client.Debug_Mode.Editor"
             xmlns:rc="clr-namespace:RichCanvas;assembly=RichCanvas"
             xmlns:converters="clr-namespace:RichCanvasUIA.Client.Converters"
             mc:Ignorable="d"
             d:DesignHeight="1000 "
             d:DesignWidth="500"
             d:DataContext="{d:DesignInstance editor:RichCanvasEditorHost}">
    <UserControl.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    </UserControl.Resources>
    <Grid Visibility="{Binding RichCanvasEditor.SelectedItem, Converter={StaticResource NullToVisibilityConverter}}"
          IsVisibleChanged="Grid_IsVisibleChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border BorderBrush="Black"
                BorderThickness="1"
                MaxWidth="100"
                MaxHeight="100"
                VerticalAlignment="Top">
            <rc:RichCanvasContainer Content="{Binding RichCanvasEditor.SelectedItem}"
                                    Width="{Binding RichCanvasEditor.SelectedItem.Width}"
                                    Height="{Binding RichCanvasEditor.SelectedItem.Height}"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    RenderTransform="{Binding RelativeSource={RelativeSource AncestorType=local:RichCanvasEditorItemPreview}, Path=RichCanvasEditorControl.SelectedContainer.RenderTransform}"
                                    IsHitTestVisible="False">
            </rc:RichCanvasContainer>
        </Border>
    </Grid>
</UserControl>
 