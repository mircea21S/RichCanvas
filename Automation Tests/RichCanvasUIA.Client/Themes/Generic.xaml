<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:overlay="clr-namespace:RichCanvasUIA.Client.Debug_Mode.Overlay">

    <Style TargetType="{x:Type overlay:OverlayHost}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type overlay:OverlayHost}">
                    <Grid x:Name="PART_LayoutRoot">

                        <Grid Panel.ZIndex="99">
                            <ContentPresenter x:Name="PART_Overlay"
                                              Content="{TemplateBinding Overlay}">
                            </ContentPresenter>
                        </Grid>

                        <ContentPresenter x:Name="PART_Content" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
